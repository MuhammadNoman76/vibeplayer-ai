<Window x:Class="VibePlayer.Views.ScenesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenes to skip"
        Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="#F1F1F1">
    <Border x:Name="Card" Background="#212121" CornerRadius="14" BorderBrush="#3A3A3A" BorderThickness="1" Padding="24,20" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Scenes to skip" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Every scene this video skips. Pink ones were found by the AI, amber ones you added. Change any of them; the file itself is never changed."
                       Foreground="#AAAAAA" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="NoticeText" Foreground="#FFC400" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <Border Background="#181818" CornerRadius="10" Margin="0,12,0,0" Padding="6">
                <ScrollViewer x:Name="ListScroll" MaxHeight="264" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SceneList" />
                </ScrollViewer>
            </Border>

            <Border x:Name="Editor" Background="#2A2A2A" CornerRadius="10" Margin="0,12,0,0" Padding="16,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Starts at" Foreground="#AAAAAA" FontSize="12.5" Margin="2,0,0,6" />
                            <DockPanel>
                                <Button x:Name="StartLater" Content="+1 s" DockPanel.Dock="Right" Style="{StaticResource SecondaryPill}" Height="36" Padding="10,0" Margin="6,0,0,0" ToolTip="Start one second later (shorter)" />
                                <Button x:Name="StartEarlier" Content="−1 s" DockPanel.Dock="Right" Style="{StaticResource SecondaryPill}" Height="36" Padding="10,0" Margin="6,0,0,0" ToolTip="Start one second earlier (longer)" />
                                <TextBox x:Name="StartBox" Style="{StaticResource DarkTextBox}" Height="36" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ends at" Foreground="#AAAAAA" FontSize="12.5" Margin="2,0,0,6" />
                            <DockPanel>
                                <Button x:Name="EndLater" Content="+1 s" DockPanel.Dock="Right" Style="{StaticResource SecondaryPill}" Height="36" Padding="10,0" Margin="6,0,0,0" ToolTip="End one second later (longer)" />
                                <Button x:Name="EndEarlier" Content="−1 s" DockPanel.Dock="Right" Style="{StaticResource SecondaryPill}" Height="36" Padding="10,0" Margin="6,0,0,0" ToolTip="End one second earlier (shorter)" />
                                <TextBox x:Name="EndBox" Style="{StaticResource DarkTextBox}" Height="36" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12.5" Margin="2,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="WatchButton" Content="Watch it once" Style="{StaticResource SecondaryPill}" Height="36" Margin="0,0,8,0" ToolTip="Close this window and play the scene once, without skipping it" />
                        <Button x:Name="SkipButton" Style="{StaticResource SecondaryPill}" Height="36" Margin="0,0,8,0" />
                        <Button x:Name="ResetButton" Content="Back to the AI's times" Style="{StaticResource GhostPill}" Height="36" Margin="0,0,8,0" />
                        <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource GhostPill}" Height="36" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button x:Name="AddButton" Content="+  Add a scene" DockPanel.Dock="Left" Style="{StaticResource SecondaryPill}" ToolTip="Skip a part the AI missed: it starts where you are now" />
                <Button x:Name="DoneButton" Content="Done" DockPanel.Dock="Right" Style="{StaticResource PrimaryPill}" MinWidth="96" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
