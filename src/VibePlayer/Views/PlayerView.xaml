<UserControl x:Class="VibePlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VibePlayer.Controls"
             FontFamily="{StaticResource UiFont}"
             Foreground="#F1F1F1"
             FontSize="14"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid x:Name="Root" Background="#01000000" AllowDrop="True" ClipToBounds="True">

        <!-- Click / double-click / press-and-hold surface (the video itself) -->
        <Border x:Name="Surface" Background="#01000000" />

        <!-- Audio-only view -->
        <Grid x:Name="AudioPanel" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.9">
                    <GradientStop Color="#33162A" Offset="0" />
                    <GradientStop Color="#0F0F0F" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,90">
                <Border x:Name="ArtBorder" Width="200" Height="200" CornerRadius="18" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF2D46" Offset="0" />
                            <GradientStop Color="#DE1478" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <c:IconView x:Name="ArtIcon" Data="{StaticResource Icon.Audio}" Width="96" Height="96" />
                </Border>
                <TextBlock x:Name="AudioTitle" FontSize="22" FontWeight="SemiBold" Margin="0,22,0,0" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="600" />
                <TextBlock x:Name="AudioArtist" FontSize="14" Foreground="#AAAAAA" Margin="0,6,0,0" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="600" />
            </StackPanel>
        </Grid>

        <!-- Buffering spinner -->
        <Grid x:Name="Spinner" Width="60" Height="60" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="SpinnerRotate" />
            </Grid.RenderTransform>
            <Path Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M30,4 A26,26 0 1 1 4,30" />
        </Grid>

        <!-- Play / pause flash in the middle -->
        <Grid x:Name="CenterFlash" Width="72" Height="72" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CenterFlashScale" />
            </Grid.RenderTransform>
            <Ellipse Fill="#99000000" />
            <c:IconView x:Name="CenterFlashIcon" Width="38" Height="38" />
        </Grid>

        <!-- Seek bubbles (J / L / arrow keys) -->
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border x:Name="SeekBubbleLeft" Grid.Column="0" Width="116" Height="116" CornerRadius="58" Background="#80000000" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <c:IconView Data="{StaticResource Icon.FastRewind}" Width="30" Height="30" />
                    <TextBlock x:Name="SeekTextLeft" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="SeekBubbleRight" Grid.Column="2" Width="116" Height="116" CornerRadius="58" Background="#80000000" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <c:IconView Data="{StaticResource Icon.FastForward}" Width="30" Height="30" />
                    <TextBlock x:Name="SeekTextRight" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Player chrome ===================== -->
        <Grid x:Name="Chrome">
            <Border Height="180" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#4D000000" Offset="0.5" />
                        <GradientStop Color="#B3000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- AI scan progress (see PlayerView.Ai.cs); fades with the controls -->
            <Border x:Name="AiPill" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,16,0,0" Background="#8C000000"
                    CornerRadius="16" Padding="12,6,14,6" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Data="{StaticResource Icon.Ai}" Width="16" Height="16" Fill="#FF3D8B" Margin="0,0,8,0" />
                    <TextBlock x:Name="AiPillText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid x:Name="ControlsHost" VerticalAlignment="Bottom" Margin="12,0,12,12">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ControlsScale" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Progress bar -->
                <Grid x:Name="ProgressArea" Height="20" Margin="4,0,4,8" Background="#01000000" Cursor="Hand">
                    <Grid x:Name="TrackGrid" Height="3" VerticalAlignment="Center">
                        <Rectangle Fill="#4DFFFFFF" RadiusX="1.5" RadiusY="1.5" />
                        <Rectangle x:Name="HoverFill" Fill="#80FFFFFF" HorizontalAlignment="Left" Width="0" Visibility="Collapsed" RadiusX="1.5" RadiusY="1.5" />
                        <Rectangle x:Name="PlayedFill" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" Width="0" RadiusX="1.5" RadiusY="1.5" />
                        <!-- Parts of the video that will be skipped -->
                        <Canvas x:Name="SkipMarks" IsHitTestVisible="False" />
                    </Grid>
                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                             VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ThumbScale" ScaleX="0.9" ScaleY="0.9" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- Button row -->
                <Grid Grid.Row="1" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PrevButton" Style="{StaticResource CircleButton}" Margin="0,0,8,0" Visibility="Collapsed">
                            <c:IconView Data="{StaticResource Icon.Previous}" Width="24" Height="24" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource CircleButton}">
                            <c:IconView x:Name="PlayIcon" Data="{StaticResource Icon.Play}" Width="28" Height="28" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource CircleButton}" Margin="8,0,0,0" Visibility="Collapsed">
                            <c:IconView Data="{StaticResource Icon.Next}" Width="24" Height="24" />
                        </Button>

                        <Border x:Name="VolumeGroup" Background="{StaticResource ChipBrush}" CornerRadius="24" Height="48" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="VolumeButton" Style="{StaticResource BarButton}">
                                    <c:IconView x:Name="VolumeIcon" Data="{StaticResource Icon.VolumeHigh}" />
                                </Button>
                                <Grid x:Name="VolumeSliderHost" Width="0" ClipToBounds="True">
                                    <Grid x:Name="VolumeSlider" Width="60" Margin="0,0,16,0" HorizontalAlignment="Left" Background="#01000000" Cursor="Hand">
                                        <Rectangle Height="3" Fill="#4DFFFFFF" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" />
                                        <Rectangle x:Name="VolumeFill" Height="3" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5" />
                                        <Ellipse x:Name="VolumeThumb" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="TimePill" Background="{StaticResource ChipBrush}" CornerRadius="24" Height="48" Margin="8,0,0,0" Padding="18,0" Cursor="Hand">
                            <TextBlock x:Name="TimeText" Text="0:00 / 0:00" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <Border x:Name="RightPill" Grid.Column="2" Background="{StaticResource ChipBrush}" CornerRadius="24" Height="48">
                        <StackPanel Orientation="Horizontal" Margin="2,0">
                            <Button x:Name="AutoplayButton" Style="{StaticResource BarButton}" Width="58">
                                <Grid Width="36" Height="20">
                                    <Border x:Name="AutoplayTrack" Height="14" CornerRadius="7" Background="#80FFFFFF" VerticalAlignment="Center" />
                                    <Grid Width="20" Height="20" HorizontalAlignment="Left">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="AutoplayKnobShift" />
                                        </Grid.RenderTransform>
                                        <Ellipse x:Name="AutoplayKnob" Fill="#F1F1F1" />
                                        <c:IconView x:Name="AutoplayKnobIcon" Data="{StaticResource Icon.Pause}" Width="13" Height="13" Fill="#0F0F0F" />
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button x:Name="CcButton" Style="{StaticResource BarButton}">
                                <Grid Width="26" Height="30">
                                    <c:IconView Data="{StaticResource Icon.Subtitles}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Rectangle x:Name="CcUnderline" Height="3" Width="22" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}"
                                               VerticalAlignment="Bottom" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <Button x:Name="SettingsButton" Style="{StaticResource BarButton}">
                                <Grid Width="32" Height="32">
                                    <c:IconView Data="{StaticResource Icon.Settings}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <c:IconView.RenderTransform>
                                            <RotateTransform x:Name="SettingsRotate" />
                                        </c:IconView.RenderTransform>
                                    </c:IconView>
                                    <Border x:Name="QualityBadge" Background="{StaticResource AccentBrush}" CornerRadius="2" Padding="2,0,2,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,-4,0" Visibility="Collapsed">
                                        <TextBlock x:Name="QualityBadgeText" Text="HD" FontSize="8" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button x:Name="MiniButton" Style="{StaticResource BarButton}">
                                <c:IconView Data="{StaticResource Icon.Miniplayer}" />
                            </Button>
                            <Button x:Name="FullscreenButton" Style="{StaticResource BarButton}">
                                <c:IconView x:Name="FullscreenIcon" Data="{StaticResource Icon.Fullscreen}" Width="27" Height="27" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- "2x >>" / volume / speed indicator -->
        <Border x:Name="InfoPill" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,52,0,0" Background="#8C000000"
                CornerRadius="20" Padding="16,8" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <c:IconView x:Name="InfoIcon" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed" />
                <TextBlock x:Name="InfoText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel x:Name="InfoChevrons" Orientation="Horizontal" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                    <c:IconView x:Name="Chevron1" Data="{StaticResource Icon.Play}" Width="16" Height="16" />
                    <c:IconView x:Name="Chevron2" Data="{StaticResource Icon.Play}" Width="16" Height="16" Margin="-6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- YouTube-style settings menu -->
        <Border x:Name="SettingsPanel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,84"
                Background="#EB1C1C1C" CornerRadius="12" Visibility="Collapsed" MinWidth="270">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SettingsItems" Margin="0,8" />
            </ScrollViewer>
        </Border>

        <!-- Tooltips & progress hover time -->
        <Canvas x:Name="TipLayer" IsHitTestVisible="False">
            <Border x:Name="TipBox" Background="#E61C1C1C" CornerRadius="6" Padding="9,5" Visibility="Collapsed">
                <TextBlock x:Name="TipText" FontSize="12.5" FontWeight="SemiBold" />
            </Border>
            <Border x:Name="HoverTime" Background="#E61C1C1C" CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                <TextBlock x:Name="HoverTimeText" FontSize="13" FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <!-- Start screen -->
        <Grid x:Name="WelcomePanel">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1">
                    <GradientStop Color="#231A1F" Offset="0" />
                    <GradientStop Color="#0F0F0F" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,32" MaxWidth="580">
                    <Grid Width="84" Height="84" HorizontalAlignment="Center">
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF2D46" Offset="0" />
                                    <GradientStop Color="#DE1478" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <c:IconView Data="{StaticResource Icon.Play}" Width="46" Height="46" Margin="4,0,0,0" />
                    </Grid>
                    <TextBlock Text="VibeVideo AI" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Plays almost any video or audio file, powered by the VLC engine. On-device AI finds nudity, sex and kissing scenes and skips them." Foreground="#AAAAAA"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="WelcomeOpenFile" Style="{StaticResource PrimaryPill}" Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.File}" Width="18" Height="18" Fill="#0F0F0F" Margin="0,0,8,0" />
                                <TextBlock Text="Open file" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WelcomeOpenFolder" Style="{StaticResource SecondaryPill}" Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Folder}" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Open folder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WelcomeOpenUrl" Style="{StaticResource SecondaryPill}" Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource Icon.Link}" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Open URL" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="or drag &amp; drop files here" Foreground="#8A8A8A" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />

                    <StackPanel x:Name="RecentSection" Margin="0,30,0,0" Visibility="Collapsed">
                        <TextBlock Text="Recent" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,6" />
                        <StackPanel x:Name="RecentList" />
                    </StackPanel>

                    <TextBlock x:Name="WelcomeTip" Foreground="#717171" FontSize="12" HorizontalAlignment="Center" Margin="0,26,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="Tip: press and hold the right side of the video to watch at 2x  ·  press ? for keyboard shortcuts" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Small notifications -->
        <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,100,24,0" Background="#EB212121"
                CornerRadius="10" Padding="16,10" Opacity="0" IsHitTestVisible="False" MaxWidth="640">
            <TextBlock x:Name="ToastText" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>

        <!-- "A new version is available" (never modal; see PlayerView.Updates.cs) -->
        <Border x:Name="UpdateCard" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Width="400"
                Background="#F2212121" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="14" Padding="18,16,18,16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,12,0">
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF2D46" Offset="0" />
                                    <GradientStop Color="#DE1478" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <c:IconView Data="{StaticResource Icon.Download}" Width="20" Height="20" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateSubtitle" FontSize="12.5" Foreground="#AAAAAA" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="UpdateCloseButton" Grid.Column="2" Style="{StaticResource BarButton}" Width="32" Height="32"
                            VerticalAlignment="Top" Margin="4,-4,-8,0" AutomationProperties.Name="Close">
                        <c:IconView Data="{StaticResource Icon.Close}" Width="18" Height="18" />
                    </Button>
                </Grid>

                <StackPanel x:Name="UpdateNotes" Margin="0,12,0,0" />

                <StackPanel x:Name="UpdateProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid x:Name="UpdateProgressTrack" Height="4">
                        <Border CornerRadius="2" Background="#4DFFFFFF" />
                        <Border x:Name="UpdateProgressFill" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <TextBlock x:Name="UpdateProgressText" FontSize="12.5" Foreground="#DDDDDD" Margin="0,8,0,0" />
                </StackPanel>

                <TextBlock x:Name="UpdateStatus" FontSize="12.5" Foreground="#FF6B6B" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <DockPanel Margin="0,16,0,0" LastChildFill="False">
                    <Button x:Name="UpdateSkipButton" DockPanel.Dock="Left" Content="Skip this version" Style="{StaticResource GhostPill}"
                            Padding="12,0" FontSize="13" FontWeight="Normal" Height="36" Margin="-12,0,0,0" />
                    <Button x:Name="UpdateNowButton" DockPanel.Dock="Right" Content="Update now" Style="{StaticResource PrimaryPill}" Height="36" Margin="8,0,0,0" />
                    <Button x:Name="UpdateLaterButton" DockPanel.Dock="Right" Content="Later" Style="{StaticResource GhostPill}" Height="36" />
                    <Button x:Name="UpdateCancelButton" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryPill}" Height="36" Visibility="Collapsed" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Keyboard shortcuts & about -->
        <Grid x:Name="ShortcutsPanel" Background="#B3000000" Visibility="Collapsed">
            <Border x:Name="ShortcutsCard" Background="#212121" CornerRadius="14" Padding="28,20,28,20" HorizontalAlignment="Center"
                    VerticalAlignment="Center" MaxWidth="820" Margin="24">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Keyboard shortcuts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="ShortcutsClose" Style="{StaticResource BarButton}" Width="38" Height="38" HorizontalAlignment="Right" Margin="0,-4,-12,0">
                            <c:IconView Data="{StaticResource Icon.Close}" Width="20" Height="20" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="AboutText" DockPanel.Dock="Bottom" Foreground="#8A8A8A" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid x:Name="ShortcutsGrid" Columns="2" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Drag & drop hint -->
        <Grid x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False" Background="#B3000000">
            <Rectangle Margin="24" RadiusX="18" RadiusY="18" Stroke="#99FFFFFF" StrokeThickness="2" StrokeDashArray="6 4" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <c:IconView Data="{StaticResource Icon.Play}" Width="56" Height="56" />
                <TextBlock Text="Drop to play" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
