<Window x:Class="VibePlayer.Views.InstanceChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VibePlayer.Controls"
        Title="VibeVideo AI"
        Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="#F1F1F1">
    <Border x:Name="Card" Background="#212121" CornerRadius="14" BorderBrush="#3A3A3A" BorderThickness="1" Padding="24,20" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,12,0">
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2D46" Offset="0" />
                                <GradientStop Color="#DE1478" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <c:IconView Data="{StaticResource Icon.Play}" Width="18" Height="18" Margin="2,0,0,0" />
                </Grid>
                <TextBlock Text="VibeVideo AI is already open" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="Message" Foreground="#CCCCCC" FontSize="14" Margin="0,14,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="RememberBox" Style="{StaticResource DarkCheckBox}" Margin="0,18,0,0"
                      Content="Remember my choice (change it later from the right-click menu)" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostPill}" />
                <Button x:Name="NewButton" Content="Open new window" Style="{StaticResource SecondaryPill}" Margin="8,0,0,0" />
                <Button x:Name="ExistingButton" Style="{StaticResource PrimaryPill}" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
