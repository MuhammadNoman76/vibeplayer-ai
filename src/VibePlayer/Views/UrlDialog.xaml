<Window x:Class="VibePlayer.Views.UrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open network stream"
        Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="#F1F1F1">
    <Border x:Name="Card" Background="#212121" CornerRadius="14" BorderBrush="#3A3A3A" BorderThickness="1" Padding="24,20" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Open network stream" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Paste a link to a video or audio stream: http(s), rtsp, rtmp, udp, mms, HLS (.m3u8)…"
                       Foreground="#AAAAAA" FontSize="13" Margin="0,6,0,14" TextWrapping="Wrap" />
            <TextBox x:Name="UrlBox" Style="{StaticResource DarkTextBox}" />
            <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12.5" Margin="2,8,0,0" Visibility="Collapsed"
                       Text="That doesn't look like a valid link." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostPill}" />
                <Button x:Name="OkButton" Content="Play" Style="{StaticResource PrimaryPill}" Margin="8,0,0,0" MinWidth="88" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
