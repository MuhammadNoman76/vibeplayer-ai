<Window x:Class="VibePlayer.Views.SkipRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add skip"
        Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="#F1F1F1">
    <Border x:Name="Card" Background="#212121" CornerRadius="14" BorderBrush="#3A3A3A" BorderThickness="1" Padding="24,20" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Skip a part of this video" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="The player jumps over this part every time it plays. The file itself is not changed."
                       Foreground="#AAAAAA" FontSize="13" Margin="0,6,0,16" TextWrapping="Wrap" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="From" Foreground="#AAAAAA" FontSize="12.5" Margin="2,0,0,6" />
                    <TextBox x:Name="FromBox" Style="{StaticResource DarkTextBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="To" Foreground="#AAAAAA" FontSize="12.5" Margin="2,0,0,6" />
                    <TextBox x:Name="ToBox" Style="{StaticResource DarkTextBox}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Use minutes:seconds or hours:minutes:seconds, e.g. 34:05 or 1:02:30" Foreground="#8A8A8A" FontSize="12" Margin="2,8,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12.5" Margin="2,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostPill}" />
                <Button x:Name="OkButton" Content="Add skip" Style="{StaticResource PrimaryPill}" Margin="8,0,0,0" MinWidth="96" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
